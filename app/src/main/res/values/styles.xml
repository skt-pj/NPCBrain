<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NpcBrainTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/npcbrain_background</item>
        <item name="android:colorAccent">@color/npcbrain_accent</item>
        <item name="android:navigationBarColor">@color/npcbrain_background</item>
        <item name="android:statusBarColor">@color/npcbrain_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:alertDialogTheme">@style/NpcBrainAlertDialogTheme</item>
    </style>

    <style name="NpcBrainAlertDialogTheme" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@color/npcbrain_surface</item>
        <item name="android:colorAccent">@color/npcbrain_accent</item>
        <item name="android:textColorPrimary">@color/npcbrain_text</item>
        <item name="android:textColorSecondary">@color/npcbrain_muted</item>
        <item name="android:textColorAlertDialogListItem">@color/npcbrain_text</item>
        <item name="android:colorControlNormal">@color/npcbrain_text</item>
        <item name="android:colorControlActivated">@color/npcbrain_accent</item>
    </style>

    <style name="NpcBrainPopupTheme" parent="@android:style/Theme.Material">
        <item name="android:windowBackground">@color/npcbrain_surface</item>
        <item name="android:panelColorBackground">@color/npcbrain_surface</item>
        <item name="android:colorAccent">@color/npcbrain_accent</item>
        <item name="android:textColorPrimary">@color/npcbrain_text</item>
        <item name="android:textColorSecondary">@color/npcbrain_muted</item>
    </style>
</resources>
